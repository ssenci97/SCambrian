   "source": [
    "###################################### CLUSTERING_QUALITY\n",
    "metrics = pd.Series({k: float(v) for k, v in adata.uns[\"metrics\"].items()})\n",
    "labels = [\"All species (joint)\" if k.startswith(\"joint\") else species_label.get(k.removeprefix(\"intra_silhouette_\"), k) for k in metrics.index]\n",
    "colors = [\"#7b2c6d\" if k.startswith(\"joint\") else species_palette.get(k.removeprefix(\"intra_silhouette_\"), COLOR_BG) for k in metrics.index]\n",
    "fig, ax = plt.subplots(figsize=(7, 0.55 * len(metrics) + 1.2))\n",
    "ax.barh(labels, metrics.values, color=colors)\n",
    "for y, v in enumerate(metrics.values): ax.text(v, y, f\" {v:.3f}\", va=\"center\", fontsize=FONT_TICK)\n",
    "ax.invert_yaxis()\n",
    "ax.set_xlabel(\"Silhouette score (cosine)\")\n",
    "ax.set_title(\"Leiden partition quality\")\n",
    "ax.set_xlim(min(0, metrics.min()) * 1.1, max(metrics.max() * 1.2, 0.1))\n",
    "fig.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b8ead10b",
   "metadata": {},
   "outputs": [],
   "source": [
    "###################################### TOP_SIGNATURES\n",
    "THRESHOLD = ydata.get(\"h5ad_scanpy\", {}).get(\"min_percent_enrichment\", 80)\n",
    "species_clusters = {sp: enrichment_df.index[enrichment_df[sp] > THRESHOLD].tolist() for sp in species_columns}\n",
    "rows = [(species_label[sp], c, int(counts_df.loc[c, sp]), int(counts_df.loc[c].sum()), round(float(enrichment_df.loc[c, sp]), 1)) for sp, cls in species_clusters.items() for c in cls]\n",
    "signatures = pd.DataFrame(rows, columns=[\"species\", \"cluster\", \"species proteins\", \"cluster proteins\", \"species %\"])\n",
    "print(f\"[PYTHON-INFO] Clusters with more than {THRESHOLD}% proteins of one species: {len(signatures)}\")\n",
    "display(signatures.style.hide(axis=\"index\").background_gradient(cmap=CMAP_SEQ, subset=[\"species %\"], vmin=THRESHOLD, vmax=100))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "53fd1f0b",
   "metadata": {},
   "outputs": [],
   "source": [
    "###################################### CHANNEL_CLUSTERMAP\n",
    "allowed = {c: sp for sp, cls in species_clusters.items() if sp not in BAN_SPECIES for c in cls}\n",
    "df_subset = channels_df[(channels_df[\"analysis\"] == \"inter_group\") & channels_df[\"cluster\"].astype(str).isin(list(allowed))].astype({\"cluster\": str})\n",
    "if len(allowed) < 2 or df_subset.empty:\n",
    "    print(f\"[PYTHON-INFO] Fewer than two species-enriched clusters; no channel clustermap.\")\n",
    "else:\n",
    "    pivot_scores = df_subset.pivot(index=\"cluster\", columns=\"channel\", values=\"score\")\n",
    "    mask = (df_subset.pivot(index=\"cluster\", columns=\"channel\", values=\"pvals_adj\") > PVAL_THRESHOLD).reindex_like(pivot_scores).fillna(True)\n",
    "    pivot_scores, mask = pivot_scores.loc[:, ~mask.all(axis=0)], mask.loc[:, ~mask.all(axis=0)]\n",
    "    norm_df = pivot_scores.sub(pivot_scores.mean(axis=1), axis=0).div(pivot_scores.std(axis=1).replace(0, 1), axis=0).fillna(0)\n",
    "    row_colors = [species_palette.get(allowed.get(c, \"\"), COLOR_BG) for c in norm_df.index]\n",
    "    cmap = CMAP_DIV.copy()\n",
    "    cmap.set_bad(\"#F2F2F2\")\n",
    "    g = sns.clustermap(norm_df, mask=mask, cmap=cmap, center=0, vmin=Z_MIN, vmax=Z_MAX, figsize=(11, max(4, 0.3 * len(norm_df) + 2.5)), row_colors=row_colors, xticklabels=False, yticklabels=True, dendrogram_ratio=(0.08, 0.1), cbar_pos=None)\n",
    "    g.ax_heatmap.set_xlabel(f\"ESMC channels with an adjusted p < {PVAL_THRESHOLD} (n = {norm_df.shape[1]})\")\n",
    "    g.ax_heatmap.set_ylabel(\"Joint cluster\")\n",
    "    g.fig.suptitle(\"Channel markers of species-enriched clusters\", fontsize=FONT_TITLE, y=1.02)\n",
    "    g.fig.subplots_adjust(bottom=0.24)\n",
    "    g.fig.colorbar(ScalarMappable(norm=Normalize(Z_MIN, Z_MAX), cmap=CMAP_DIV), cax=g.fig.add_axes([0.6, 0.06, 0.3, 0.03]), orientation=\"horizontal\", label=\"Wilcoxon score (row z-score)\")\n",
    "    g.fig.legend(handles=[mpatches.Patch(color=species_palette[s], label=species_label[s]) for s in species_columns if s not in BAN_SPECIES], loc=\"lower left\", bbox_to_anchor=(0.05, 0.0), ncol=min(3, len(species_columns)), frameon=False, title=\"Species\")\n",
    "    plt.show()"
   ]
  }
