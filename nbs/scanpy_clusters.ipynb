   "source": [
    "#!/usr/bin/env python3\n",
    "\"\"\"Explores the joint clusters saved by npz_scanpy.py: layouts by species and cluster, species composition and enrichment per cluster, clustering quality and the channel markers of species-enriched clusters.\n",
    "\n",
    "Every .h5ad one level below the npz_scanpy outdir of configs/param_configs.yaml is listed; H5AD_INDEX picks the one to explore. Species are named and ordered as in the query configuration (exact_species) and coloured with alternating PALETTE colours.\n",
    "\"\"\"\n",
    "###################################### DEPENDENCIES_AND_CONSTANTS\n",
    "import anndata as ad\n",
    "from IPython.display import display\n",
    "import matplotlib as mpl\n",
    "from matplotlib.cm import ScalarMappable\n",
    "from matplotlib.colors import LinearSegmentedColormap, Normalize\n",
    "from matplotlib.lines import Line2D\n",
    "import matplotlib.patches as mpatches\n",
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "from pathlib import Path\n",
    "from pyprojroot import find_root, has_file\n",
    "import seaborn as sns\n",
    "import warnings\n",
    "import yaml\n",
    "warnings.filterwarnings(\"ignore\", category=UserWarning)\n",
    "BAN_SPECIES = []\n",
    "COLOR_BG = \"#BFC5CE\"\n",
    "CMAP_DIV = LinearSegmentedColormap.from_list(\"scambrian_div\", [\"#76BBE2\", \"#FFFFFF\", \"#7b2c6d\"])\n",
    "CMAP_SEQ = LinearSegmentedColormap.from_list(\"scambrian\", [\"#76BBE2\", \"#7b2c6d\"])\n",
    "DEFAULT_OUTDIR = \"data/scanpy/\"\n",
    "DEFAULT_QUERY_TSV = \"configs/query_configs.tsv\"\n",
    "DPI = 120\n",
    "FONT_LABEL = 13\n",
    "FONT_LEGEND = 12\n",
    "FONT_TICK = 11\n",
    "FONT_TITLE = 15\n",
    "H5AD_INDEX = 0\n",
    "LEGEND_NCOL_MAX = 6\n",
    "MARKER_SIZE = 2\n",
    "MAX_LABELLED_CLUSTERS = 10\n",
    "N_TOP_CLUSTERS = 30\n",
    "PALETTE = [\"#ECDE90\", \"#93DEB6\", \"#F1B584\", \"#76BBE2\", \"#DA919B\", \"#899E64\", \"#8E81B9\", \"#A66C58\", \"#30767A\", \"#7A5271\"]\n",
    "PVAL_THRESHOLD = 0.05\n",
    "YAML_PATH = \"configs/param_configs.yaml\"\n",
    "Z_MIN, Z_MAX = -2, 2\n",
    "plt.rcParams.update({\"figure.dpi\": DPI, \"font.size\": FONT_TICK, \"axes.titlesize\": FONT_TITLE, \"axes.labelsize\": FONT_LABEL, \"xtick.labelsize\": FONT_TICK, \"ytick.labelsize\": FONT_TICK, \"legend.fontsize\": FONT_LEGEND, \"axes.spines.top\": False, \"axes.spines.right\": False})\n",
    "###################################### DISCOVERY\n",
    "PROJECT_ROOT = find_root(has_file(\".here\"), start=Path.cwd()).resolve()\n",
    "ydata = (yaml.safe_load((PROJECT_ROOT / YAML_PATH).read_text()) or {}) if (PROJECT_ROOT / YAML_PATH).exists() else {}\n",
    "def species_names() -> dict[str, str]:\n",
    "    \"\"\"Map each label of the query configuration to its exact_species name, keeping the configuration order.\n",
    "\n",
    "    Returns:\n",
    "        dict[str, str]: Label -> display name.\n",
    "    \"\"\"\n",
    "    tsv = PROJECT_ROOT / ydata.get(\"dw_uniprot_seqs\", {}).get(\"config_path\", DEFAULT_QUERY_TSV)\n",
    "    df = pd.read_csv(tsv, sep=\"\\t\", dtype=str) if tsv.exists() else pd.DataFrame(columns=[\"label\"])\n",
    "    names = df[\"exact_species\"] if \"exact_species\" in df else df[\"label\"]\n",
    "    return {lbl: (nm if pd.notna(nm) and str(nm).strip() else lbl) for lbl, nm in zip(df[\"label\"], names) if pd.notna(lbl)}\n",
    "def bottom_legend(fig: plt.Figure, handles: list, title: str | None = None) -> None:\n",
    "    \"\"\"Draw a frameless legend centred below the figure with an adaptive number of columns.\n",
    "\n",
    "    Args:\n",
    "        fig (plt.Figure): Figure.\n",
    "        handles (list): Legend handles.\n",
    "        title (str | None): Legend title.\n",
    "    \"\"\"\n",
    "    fig.legend(handles=handles, loc=\"upper center\", bbox_to_anchor=(0.5, 0.0), ncol=min(LEGEND_NCOL_MAX, max(1, len(handles))), frameon=False, title=title, title_fontsize=FONT_LEGEND)\n",
    "SPECIES_NAMES = species_names()\n",
    "outdir = PROJECT_ROOT / ydata.get(\"npz_scanpy\", {}).get(\"outdir\", DEFAULT_OUTDIR)\n",
    "h5ads = sorted(outdir.glob(\"*/*.h5ad\"))\n",
    "if not h5ads: raise FileNotFoundError(f\"[PYTHON-ERROR] No .h5ad found in {outdir}/<run>/; run slurms/supp_01_scanpy.sh first.\")\n",
    "for i, p in enumerate(h5ads): print(f\"[PYTHON-INFO] {'>' if i == H5AD_INDEX else ' '} [{i}] {p.relative_to(outdir)}\")\n",
    "###################################### LOAD\n",
    "adata = ad.read_h5ad(h5ads[H5AD_INDEX])\n",
    "rank = {s: i for i, s in enumerate(SPECIES_NAMES)}\n",
    "species_columns = sorted(adata.obs[\"species\"].astype(str).unique(), key=lambda s: (rank.get(s, len(rank)), s))\n",
    "species_label = {s: SPECIES_NAMES.get(s, s) for s in species_columns}\n",
    "species_palette = {s: PALETTE[i % len(PALETTE)] for i, s in enumerate(species_columns)}\n",
    "metadata_df = adata.obs[[\"protein_id\", \"species\", \"cluster\", \"intra_cluster\"]].astype({\"species\": str, \"cluster\": str}).reset_index(drop=True)\n",
    "counts_df = pd.crosstab(metadata_df[\"cluster\"], metadata_df[\"species\"]).reindex(columns=species_columns, fill_value=0)\n",
    "counts_df = counts_df.loc[counts_df.sum(axis=1).sort_values(ascending=False, kind=\"stable\").index]\n",
    "enrichment_df = counts_df.div(counts_df.sum(axis=1), axis=0) * 100\n",
    "channels_df = adata.uns[\"markers\"]\n",
    "summary = pd.DataFrame({\"species\": [species_label[s] for s in species_columns], \"proteins\": counts_df.sum().values, \"joint clusters (>0 proteins)\": (counts_df > 0).sum().values, \"intra clusters\": [metadata_df.loc[metadata_df[\"species\"] == s, \"intra_cluster\"].nunique() for s in species_columns]})\n",
    "print(f\"[PYTHON-INFO] {h5ads[H5AD_INDEX].name}: {adata.n_obs:,} proteins, {len(species_columns)} species, {len(counts_df)} joint clusters\")\n",
    "display(summary.style.hide(axis=\"index\"))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5e3de8fc",
   "metadata": {},
   "outputs": [],
   "source": [
    "###################################### LAYOUT_OVERVIEW\n",
    "methods = [m for m in (\"umap\", \"tsne\") if f\"X_{m}_2d\" in adata.obsm]\n",
    "top = list(counts_df.index[:MAX_LABELLED_CLUSTERS])\n",
    "cluster_palette = {c: PALETTE[i % len(PALETTE)] for i, c in enumerate(top)}\n",
    "fig, axes = plt.subplots(len(methods), 2, figsize=(11, 5.2 * len(methods)), squeeze=False)\n",
    "rng = np.random.default_rng(42)\n",
    "order = rng.permutation(adata.n_obs)\n",
    "for r, m in enumerate(methods):\n",
    "    xy = adata.obsm[f\"X_{m}_2d\"]\n",
    "    name = {\"umap\": \"UMAP\", \"tsne\": \"t-SNE\"}[m]\n",
    "    sp_colors = metadata_df[\"species\"].map(species_palette).to_numpy()\n",
    "    axes[r, 0].scatter(xy[order, 0], xy[order, 1], c=sp_colors[order], s=MARKER_SIZE, linewidths=0, rasterized=True)\n",
    "    cl_colors = metadata_df[\"cluster\"].map(cluster_palette).fillna(COLOR_BG).to_numpy()\n",
    "    fg = metadata_df[\"cluster\"].isin(top).to_numpy()\n",
    "    axes[r, 1].scatter(xy[~fg, 0], xy[~fg, 1], c=COLOR_BG, s=MARKER_SIZE, linewidths=0, alpha=0.5, rasterized=True)\n",
    "    axes[r, 1].scatter(xy[fg, 0], xy[fg, 1], c=cl_colors[fg], s=MARKER_SIZE, linewidths=0, rasterized=True)\n",
    "    for c in top:\n",
    "        cx, cy = np.median(xy[(metadata_df[\"cluster\"] == c).to_numpy()], axis=0)\n",
    "        axes[r, 1].text(cx, cy, c, fontsize=FONT_TICK, weight=\"bold\", ha=\"center\", va=\"center\", bbox=dict(boxstyle=\"round,pad=0.15\", fc=\"white\", ec=\"none\", alpha=0.7))\n",
    "    for c, title in enumerate((\"by species\", f\"by joint cluster (top {len(top)})\")):\n",
    "        axes[r, c].set_title(f\"{name} {title}\")\n",
    "        axes[r, c].set_xlabel(f\"{name}-1\")\n",
    "        axes[r, c].set_ylabel(f\"{name}-2\")\n",
    "        axes[r, c].set_xticks([])\n",
    "        axes[r, c].set_yticks([])\n",
    "bottom_legend(fig, [Line2D([0], [0], marker=\"o\", linestyle=\"\", markersize=9, color=species_palette[s], label=f\"{species_label[s]} (n={counts_df[s].sum():,})\") for s in species_columns], \"Species\")\n",
    "fig.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "b7eda167",
   "metadata": {},
   "outputs": [],
   "source": [
    "###################################### CLUSTER_COMPOSITION\n",
    "shown = counts_df.iloc[:N_TOP_CLUSTERS]\n",
    "fig, (ax_n, ax_p) = plt.subplots(1, 2, figsize=(12, max(4, 0.28 * len(shown) + 1.5)), sharey=True)\n",
    "left_n, left_p = np.zeros(len(shown)), np.zeros(len(shown))\n",
    "for s in species_columns:\n",
    "    ax_n.barh(shown.index, shown[s], left=left_n, color=species_palette[s], edgecolor=\"white\", linewidth=0.4)\n",
    "    ax_p.barh(shown.index, enrichment_df.loc[shown.index, s], left=left_p, color=species_palette[s], edgecolor=\"white\", linewidth=0.4)\n",
    "    left_n += shown[s].to_numpy()\n",
    "    left_p += enrichment_df.loc[shown.index, s].to_numpy()\n",
    "ax_n.invert_yaxis()\n",
    "ax_n.set_xlabel(\"Proteins\")\n",
    "ax_n.set_ylabel(\"Joint cluster\")\n",
    "ax_n.set_title(f\"Size of the {len(shown)} largest clusters\")\n",
    "ax_p.set_xlabel(\"Proteins (%)\")\n",
    "ax_p.set_xlim(0, 100)\n",
    "ax_p.axvline(ydata.get(\"h5ad_scanpy\", {}).get(\"min_percent_enrichment\", 80), color=\"black\", lw=0.8, ls=\"--\")\n",
    "ax_p.set_title(\"Species composition\")\n",
    "bottom_legend(fig, [mpatches.Patch(color=species_palette[s], label=species_label[s]) for s in species_columns], \"Species\")\n",
    "fig.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "474d13b1",
   "metadata": {},
   "outputs": [],
   "source": [
    "###################################### ENRICHMENT_HEATMAP\n",
    "fig, ax = plt.subplots(figsize=(1.6 + 1.3 * len(species_columns), max(4, 0.3 * len(shown) + 1.5)))\n",
    "sns.heatmap(enrichment_df.loc[shown.index].rename(columns=species_label), cmap=CMAP_SEQ, vmin=0, vmax=100, annot=True, fmt=\".0f\", annot_kws={\"fontsize\": FONT_TICK - 2}, linewidths=0.5, linecolor=\"white\", cbar_kws={\"label\": \"Proteins of the cluster (%)\", \"orientation\": \"horizontal\", \"pad\": 0.08, \"shrink\": 0.8}, ax=ax)\n",
    "ax.set_xlabel(\"\")\n",
    "ax.set_ylabel(\"Joint cluster\")\n",
    "ax.set_title(\"Species enrichment per cluster\")\n",
    "ax.tick_params(axis=\"x\", rotation=0)\n",
    "for t in ax.get_xticklabels(): t.set_fontstyle(\"italic\")\n",
    "fig.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
